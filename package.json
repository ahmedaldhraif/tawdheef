{
  "name": "apply-tracker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Find matching jobs and build career profiles. Free, open-source local app with built-in CLI and MCP for Codex and Claude Code.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "serve": "node server/index.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "cli": "node bin/apply-tracker.mjs",
    "mcp": "node server/mcp.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "connect": "node scripts/setup.mjs --login",
    "agent": "node scripts/agent-setup.mjs",
    "tools:catalog": "node scripts/tool-catalog.mjs",
    "release:check": "node scripts/release-check.mjs && node scripts/tool-catalog.mjs --check",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:app": "node scripts/package-app.mjs",
    "release:app:smoke": "node scripts/app-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "browser:benchmark": "node scripts/browser-benchmark.mjs",
    "background:start": "node scripts/background.mjs start",
    "background:stop": "node scripts/background.mjs stop",
    "background:status": "node scripts/background.mjs status"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.2",
    "@googleapis/calendar": "20.2.0",
    "@googleapis/gmail": "22.1.0",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.12.0",
    "google-auth-library": "11.3.4",
    "ical.js": "2.2.1",
    "imapflow": "2.11.0",
    "jszip": "^3.10.2",
    "nodemailer": "10.5.0",
    "postal-mime": "4.2.1",
    "tsdav": "2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "6.3.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
